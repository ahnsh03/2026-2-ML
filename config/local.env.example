# 이 파일을 config/local.env 로 복사해 자기 PC 경로로 채운다.
# config/local.env 는 Git에 올라가지 않는다 (.gitignore).
# 경로에 공백이 있으면 따옴표로 감싼다.
# 인지 모듈(src/), TwinLiteNet+ 원본(third_party/, 서브모듈), 수집 코드(ros/, scripts/)는 레포 안에 있다.

# ---- 추론·시각화: scripts/run_container.sh ----
# 데이터 루트 (datasets/, dataset_versions/ 가 있는 폴더). 읽기 전용으로 마운트된다
PERCEPTION_DATA="/path/to/data"

# 대상 체크포인트 폴더들이 있는 곳 (<run 이름>/best_mean.pt)
PERCEPTION_CKPT_ROOT="/path/to/checkpoints"

# torch 2.1 · OpenCV · scikit-learn 이 든 학습 이미지 이름
PERCEPTION_IMAGE="<image>:<tag>"

# 결과 폴더 (기본: 레포 상위 폴더의 outputs/)
# ML_OUTPUT_ROOT="/path/to/outputs"

# ---- 수집·가공: scripts/run_ros.sh ----
# 새로 수집한 데이터를 쓰는 곳 (기본: 레포 상위 폴더의 data/). 컨테이너 /data 로 쓰기 가능하게 마운트된다
# ML_DATA_ROOT="/path/to/ml-data"

# docker/ros-noetic/Dockerfile 로 만든 ROS Noetic 이미지 이름
ROS_IMAGE="<image>:<tag>"

# 컨테이너 이름 (기본 ml-ros-noetic). 다른 프로젝트 컨테이너와 같은 이름을 쓰지 않는다
# ROS_CONTAINER="ml-ros-noetic"

# MORAI가 생성한 gRPC Python proto 폴더 (그 아래 morai/sensor/sensor_pb2_grpc.py). 공개 레포에 넣지 않는다.
# 없으면 수집 노드는 ROS 토픽 /SaveSensorData 로 Capture 를 요청한다
# MORAI_GRPC_PROTO_ROOT="/path/to/morai_grpc_proto"
