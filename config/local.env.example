# 이 파일을 config/local.env 로 복사해 자기 PC 경로로 채운다.
# config/local.env 는 Git에 올라가지 않는다 (.gitignore).
# 경로에 공백이 있으면 따옴표로 감싼다.

# 인지 코드 레포 클론 (src/perception/ 아래 twinlite_morai, drivable_bev, camera_semantic_perception 포함)
PERCEPTION_REPO="/path/to/perception-repo"

# 데이터 루트 (datasets/, dataset_versions/ 가 있는 폴더)
PERCEPTION_DATA="/path/to/data"

# 대상 체크포인트 폴더들이 있는 곳 (<run 이름>/best_mean.pt)
PERCEPTION_CKPT_ROOT="/path/to/perception_eval/runs"

# 공식 TwinLiteNet+ 소스 (https://github.com/chequanghuy/TwinLiteNetPlus, 커밋 90f1b86)
TWINLITE_SOURCE="/path/to/TwinLiteNetPlus"

# torch 2.1 · OpenCV · scikit-learn 이 든 학습 이미지 이름
PERCEPTION_IMAGE="<image>:<tag>"

# 결과 폴더 (기본: 레포 상위 폴더의 outputs/)
# ML_OUTPUT_ROOT="/path/to/outputs"
